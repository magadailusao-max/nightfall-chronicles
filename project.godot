; Nightfall Chronicles — Godot 4 native game project.
; Config generated for direct opening via Godot's Import dialog.
config_version=5

[application]
config/name="Nightfall Chronicles"
config/icon="res://assets/art/app_icon.png"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/description="Roguelite 2D com artes de IA e motor Godot, sem WebView."

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=0

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1

[input_devices]
pointing/emulate_mouse_from_touch=false

[physics]
2d/default_gravity=0.0

[application/config]
name="Nightfall Chronicles"
